{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "10k-fetch input",
  "type": "object",
  "oneOf": [
    {
      "required": ["cik", "accession"],
      "properties": {
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}
      }
    },
    {
      "required": ["file_url"],
      "properties": {
        "file_url": {"type": "string", "format": "uri"}
      }
    }
  ],
  "properties": {
    "cik": {"type": "string"},
    "accession": {"type": "string"},
    "file_url": {"type": "string"},
    "force_refresh": {"type": "boolean", "default": false},
    "max_size_mb": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}
  }
}
