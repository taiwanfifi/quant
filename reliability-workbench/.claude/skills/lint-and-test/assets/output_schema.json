{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lint-and-test output",
  "type": "object",
  "required": ["ok", "repo", "ref", "language", "duration_ms", "idempotency_key"],
  "properties": {
    "ok": {"type": "boolean"},
    "repo": {"type": "string"},
    "ref": {"type": "string"},
    "resolved_sha": {"type": "string"},
    "language": {"type": "string"},
    "lint": {"type": "object"},
    "test": {"type": "object"},
    "duration_ms": {"type": "integer"},
    "idempotency_key": {"type": "string"},
    "warnings": {"type": "array"},
    "error_type": {"type": "string"},
    "error_message": {"type": "string"}
  }
}
