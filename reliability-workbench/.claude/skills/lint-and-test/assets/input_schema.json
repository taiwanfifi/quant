{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lint-and-test input",
  "type": "object",
  "required": ["repo_url"],
  "properties": {
    "repo_url": {"type": "string", "minLength": 5},
    "ref": {"type": "string", "default": "main"},
    "lint_only": {"type": "boolean", "default": false},
    "max_runtime_s": {"type": "integer", "minimum": 10, "maximum": 600, "default": 180},
    "clone_depth": {"type": "integer", "minimum": 1, "default": 1},
    "language_hint": {"type": ["string", "null"], "enum": ["python", "node", "rust", "go", null]}
  }
}
