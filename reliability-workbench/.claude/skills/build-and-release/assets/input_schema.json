{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "build-and-release input",
  "type": "object",
  "required": ["repo_url"],
  "properties": {
    "repo_url": {"type": "string", "minLength": 5},
    "ref": {"type": "string", "default": "main"},
    "version_bump": {"type": "string", "default": "minor"},
    "dry_run": {"type": "boolean", "default": true},
    "build_artifacts": {"type": "boolean", "default": false},
    "max_runtime_s": {"type": "integer", "minimum": 10, "maximum": 1800, "default": 180}
  }
}
