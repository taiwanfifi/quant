{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "security-scan output",
  "type": "object",
  "required": ["ok", "repo", "ref", "tools_used", "secrets_found", "summary", "duration_ms", "idempotency_key"],
  "properties": {
    "ok": {"type": "boolean"},
    "repo": {"type": "string"},
    "ref": {"type": "string"},
    "resolved_sha": {"type": "string"},
    "tools_used": {"type": "array"},
    "secrets_found": {"type": "array"},
    "summary": {"type": "object"},
    "duration_ms": {"type": "integer"},
    "idempotency_key": {"type": "string"},
    "warnings": {"type": "array"},
    "error_type": {"type": "string"},
    "error_message": {"type": "string"}
  }
}
