{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "security-scan input",
  "type": "object",
  "required": ["repo_url"],
  "properties": {
    "repo_url": {"type": "string", "minLength": 5},
    "ref": {"type": "string", "default": "main"},
    "max_runtime_s": {"type": "integer", "minimum": 10, "maximum": 600, "default": 120},
    "scan_depth": {"type": "string", "enum": ["shallow", "full"], "default": "shallow"}
  }
}
