{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "10k-resolve-incorporation input",
  "type": "object",
  "required": ["cik", "item_number"],
  "properties": {
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "item_number": {"type": "string"},
    "item_title": {"type": "string"},
    "filing_date": {"type": "string"},
    "search_window_months": {"type": "integer", "minimum": 1, "maximum": 36, "default": 18},
    "model_preference": {"type": "string", "default": "auto"}
  }
}
