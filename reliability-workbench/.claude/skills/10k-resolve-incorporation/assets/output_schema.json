{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "10k-resolve-incorporation output",
  "type": "object",
  "required": ["ok", "resolved", "elapsed_ms"],
  "properties": {
    "ok": {"type": "boolean"},
    "resolved": {"type": "boolean"},
    "reason": {"type": "string"},
    "source_doc": {
      "type": "object",
      "properties": {
        "form_type": {"type": "string"},
        "accession": {"type": "string"},
        "filed_at": {"type": "string"},
        "primary_doc": {"type": "string"}
      }
    },
    "section_found": {
      "type": "object",
      "properties": {
        "title_matched": {"type": "string"},
        "char_range": {"type": "array"},
        "extraction_method": {"type": "string"}
      }
    },
    "content_text": {"type": ["string", "null"]},
    "content_text_preview": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "elapsed_ms": {"type": "integer"},
    "tokens_in": {"type": "integer"},
    "tokens_out": {"type": "integer"},
    "cost_usd": {"type": "number"},
    "fallback_chain": {"type": "array"},
    "error_type": {"type": "string"},
    "error_message": {"type": "string"}
  }
}
