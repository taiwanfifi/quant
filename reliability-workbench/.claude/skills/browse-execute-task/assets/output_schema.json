{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "browse-execute-task output",
  "type": "object",
  "required": ["ok", "task", "steps_taken", "elapsed_ms"],
  "properties": {
    "ok": {"type": "boolean"},
    "task": {"type": "string"},
    "result": {
      "type": "object",
      "properties": {
        "answer": {"type": ["string", "null"]},
        "extracted_data": {"type": "object"},
        "url_visited": {"type": "string"}
      }
    },
    "steps_taken": {"type": "integer"},
    "recoveries": {"type": "integer"},
    "drift_reports": {"type": "array"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model_used": {"type": "string"},
    "cost_usd": {"type": "number"},
    "tokens_in": {"type": "integer"},
    "tokens_out": {"type": "integer"},
    "elapsed_ms": {"type": "integer"},
    "trace_id": {"type": "string"},
    "needs_human_review": {"type": "boolean"},
    "fallback_chain": {"type": "array"},
    "reason": {"type": "string"},
    "screenshot_id": {"type": "string"},
    "last_known_state": {"type": "string"},
    "warnings": {"type": "array"},
    "error_type": {"type": "string"},
    "error_message": {"type": "string"}
  }
}
